# U-On.Travel API key — выпускается в кабинете
# Настройки → Интеграции → API → добавить новый API-ключ
# Обязательно отметить чекбоксы POST и GET, сохранить.
# Ключ показывается только при создании, скопируйте сразу.
UON_API_KEY=

# Опционально: формат ответов (json|xml). Default — json.
UON_FORMAT=json

# Опционально: timeout HTTP-запросов в секундах
UON_TIMEOUT=30

# Опционально: задержка между запросами в миллисекундах
# (API лимит — 10 req/sec; ставим 150ms = 6.6 req/sec безопасно)
UON_THROTTLE_MS=150
