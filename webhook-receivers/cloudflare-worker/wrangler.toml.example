name = "uon-webhook-receiver"
main = "src/index.js"
compatibility_date = "2026-05-29"

# Optional: KV namespace for event history
# Создать: wrangler kv:namespace create UON_LOGS
# [[kv_namespaces]]
# binding = "UON_LOGS"
# id = "<your-namespace-id>"

# Optional: secret env vars (заводятся через `wrangler secret put`)
# wrangler secret put TELEGRAM_BOT_TOKEN
# wrangler secret put TELEGRAM_CHAT_ID
# wrangler secret put FORWARD_WEBHOOK_URL
